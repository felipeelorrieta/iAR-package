Package: iAR
Type: Package
Title: Irregularly Observed Autoregressive Models
Version: 1.3.5
Date: 2026-10-26
Authors@R: c(
    person("Elorrieta", "Felipe", email = "felipe.elorrieta@usach.cl", role = c("aut","cre")),
